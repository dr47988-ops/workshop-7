      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Crear viaje\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('tripId', pm.response.json().trip._id);"
            ]
          }
        }
