          "raw": "{\n  \"name\": \"Viaje a Guanacaste\",\n  \"destination\": \"Liberia\",\n  \"description\": \"Vacaciones\",\n  \"startDate\": \"2027-01-10\",\n  \"endDate\": \"2027-01-15\"\n}"
        }
