{
  "info": {
    "name": "Workshop 7 - Gastos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.iteration === 0 && pm.info.requestName === 'Registrar owner') pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}')); "
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Registrar owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"owner\",\n  \"email\": \"owner-{{runId}}@example.com\",\n  \"password\": \"Workshop123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registrar owner\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('ownerId', pm.response.json().user.id);"
            ]
          }
        }
