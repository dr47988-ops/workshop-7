      "name": "Registrar gasto equitativo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/trips/{{tripId}}/expenses",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Hotel\",\n  \"amount\": 100\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registrar gasto equitativo\", () => pm.response.to.have.status(201));",
              "const { expense } = pm.response.json();",
              "pm.collectionVariables.set('ownerExpenseId', expense._id);",
              "pm.test('Se reparte entre los 2 miembros', () => pm.expect(expense.splits.map(s => s.amount)).to.eql([50, 50]));",
              "pm.test('Pagó el usuario autenticado', () => pm.expect(expense.paidBy._id).to.eql(pm.collectionVariables.get('ownerId')));"
            ]
          }
        }
      ]
    },
